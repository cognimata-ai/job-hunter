# The compose test stack's environment (plan M5 Task 21; `PT`, `PB`): in place of deploy/release.lock and
# /etc/jobhunter/jobhunter.env, after deploy/images.lock:
#
#   docker compose -p jobhunter-prodtest --env-file deploy/images.lock --env-file deploy/compose.test.env \
#     -f deploy/compose.yaml -f deploy/compose.test.yaml …
#
# The four release images are the dev stack's own tags, built by compose.test.yaml (no extra images). The
# secrets are scripts/test-secrets.sh's dummies, relative to deploy/. Every URL is a stand-in on the test
# networks (stubsvc for ntfy and healthchecks, s3stub for S3): `JOBHUNTER_ENV=test` lets them be http.
app_image=jobhunter-app:dev
backup_image=jobhunter-backup:dev
docparse_image=jobhunter-docparse:dev
embedder_image=jobhunter-embedder:e2e
JOBHUNTER_SECRETS_DIR=../.secrets/test
JOBHUNTER_ENV=test
JOBHUNTER_DOMAIN=localhost
JOBHUNTER_ACME_EMAIL=ops@example.invalid
JOBHUNTER_PUBLIC_ORIGIN=https://localhost:8443
NTFY_TOPIC_URL=http://stubsvc:8099/ntfy/jobhunter-test
HEALTHCHECKS_API_URL=http://stubsvc:8099/hc/api/v3
RESTIC_REPOSITORY=s3:http://s3stub:7070/jobhunter-test/restic
AWS_DEFAULT_REGION=us-east-1
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter_bootstrap
JOBHUNTER_DB_HOST=postgres
JOBHUNTER_DB_PORT=5432
JOBHUNTER_DB_NAME=jobhunter
JOBHUNTER_EMBEDDER_URL=http://embedder:8080
JOBHUNTER_LOG_LEVEL=INFO
