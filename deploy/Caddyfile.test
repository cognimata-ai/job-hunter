# The compose test stack's Caddyfile (plan M5 Task 21; deploy/compose.test.yaml): the production one, but for
# `localhost` with Caddy's internal CA instead of ACME, whose root tests/support/prodstack.py copies out to
# verify TLS. The site is the same caddy/site.caddy, and the global options are the production ones but the
# ACME contact, which nothing here uses.
{
	skip_install_trust
	servers {
		protocols h1 h2
	}
	log default {
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
		}
	}
}

localhost {
	tls internal
	import site.caddy
}
