# The secret files of the production compose (spec §19.2), names only: never put a value in this file.
#
# Each is a file /etc/jobhunter/secrets/<name> (JOBHUNTER_SECRETS_DIR), owner root, group 10010
# (jobhunter-secrets), mode 0440, in a root:10010 0750 directory; the runbook (§19.8) provisions them. After
# the `#` of each line: the services it is mounted into, and what it is.
session_secret          # api: at least 32 random bytes, base64
data_key                # api, worker: exactly 32 random bytes, base64 (AES-256-GCM)
data_key_previous       # api, worker: the previous data key during a rotation, else an empty file
db_app                  # api, worker; postgres (init): the DML role's password
db_migrator             # migrate, restore; postgres (init): the schema owner's password
db_backup               # backup; postgres (init): the pg_read_all_data role's password
db_restore              # backup; postgres (init): the restore-test role's password
pg_bootstrap            # postgres: the bootstrap superuser's password (container init only)
anthropic_key           # worker: the Claude API key
rapidapi_key            # worker: JSearch via RapidAPI
serpapi_key             # worker: SerpApi (fallback)
adzuna_app_id           # worker: Adzuna
adzuna_app_key          # worker: Adzuna
langsmith_key           # worker: LangSmith (tracing is on in prod)
ntfy_token              # worker: the ntfy access token (optional: an empty file)
healthchecks_ping_url   # worker: the dead-man ping URL, https, ending in the check's uuid
healthchecks_api_key    # worker: the healthchecks Management API key
restic_password         # backup, restore: the offsite repository's password
s3_access_key_id        # backup, restore: the offsite repository's S3 access key
s3_secret_access_key    # backup, restore: the offsite repository's S3 secret key
