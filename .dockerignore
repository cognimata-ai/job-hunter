# The build context is the repository root; the Dockerfiles copy only pyproject.toml, uv.lock,
# .python-version and backend/ (Dockerfile), embedder/ (embedder/Dockerfile) or docparse/ (docparse/Dockerfile).
# Secrets, the local virtualenv, git metadata and caches never enter it.
.git
.venv
.secrets
frontend/node_modules
frontend/dist
**/__pycache__
.mypy_cache
.pytest_cache
.ruff_cache
.hypothesis
# Raw source recordings hold recruiter personal data (Task 6): never part of a build context.
.fixtures-raw
# Local model downloads (embedder/download_model.sh, spike V7): the embedder image downloads its own at build.
.model-cache
# docparse/Dockerfile copies the docparse/ package whole; its build file is not part of the package. (Docker
# still reads it: an ignored Dockerfile is only kept out of COPY.)
docparse/Dockerfile
